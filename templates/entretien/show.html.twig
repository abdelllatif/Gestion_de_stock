{% extends 'base.html.twig' %}

{% block title %}Détails de l'Entretien{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container py-5">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 style="color: #232946; font-family: 'Segoe UI', sans-serif; font-weight: bold; letter-spacing: 1px;">
                    <i class="bi bi-tools me-2"></i>Entretien #{{ entretien.numero }}
                </h1>
                <div>
                    <a href="{{ path('app_entretien') }}" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                    </a>
                    <button type="button" class="btn btn-outline-primary" id="editEntretienBtn" data-bs-toggle="tooltip" title="Modifier l'entretien">
                        <i class="bi bi-pencil me-2"></i>Modifier
                    </button>
                </div>
            </div>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title border-bottom pb-2">Informations générales</h5>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong>Numéro d'entretien:</strong> {{ entretien.numero }}</p>
                            <p><strong>Date:</strong> {{ entretien.date|date('d/m/Y') }}</p>
                            <p><strong>Machine:</strong> {{ entretien.machine ? entretien.machine.nom : 'N/A' }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Chantier:</strong> {{ entretien.chantier ? entretien.chantier.nom : 'N/A' }}</p>
                            <p><strong>Mécanicien:</strong> {{ entretien.mecanicien ? entretien.mecanicien.nom : 'N/A' }}</p>
                            <p><strong>Chauffeur:</strong> {{ entretien.chauffeur ? entretien.chauffeur.nom : 'N/A' }}</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Section des vidanges -->
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h5 class="mb-0"><i class="bi bi-droplet me-2"></i>Vidanges</h5>
                    <button class="btn btn-sm btn-outline-primary" id="addVidangeBtn">
                        <i class="bi bi-plus-circle me-1"></i>Ajouter
                    </button>
                </div>
                <div class="card-body">
                    {% if entretien.vidanges.count > 0 %}
                        {% for vidange in entretien.vidanges %}
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-header bg-light d-flex justify-content-between">
                                    <h6 class="mb-0 fw-bold">Vidange du {{ vidange.date|date('d/m/Y') }}</h6>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-sm btn-outline-primary edit-vidange-btn" data-id="{{ vidange.id }}" data-bs-toggle="tooltip" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger delete-vidange-btn" data-id="{{ vidange.id }}" data-bs-toggle="tooltip" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <h6 class="text-muted mb-2"><i class="bi bi-info-circle me-2"></i>Informations générales</h6>
                                                <ul class="list-unstyled ps-3">
                                                    <li><strong>Kilométrage actuel:</strong> {{ vidange.kilometre ?? 'N/A' }} km</li>
                                                    <li><strong>Montant TTC:</strong> {{ vidange.montantTtc ?? 0 }} DH</li>
                                                    <li><strong>Type d'huile:</strong> {{ vidange.typeChangment }}</li>
                                                    <li><strong>Quantité:</strong> {{ vidange.consomation }} L</li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <h6 class="text-muted mb-2"><i class="bi bi-check2-circle me-2"></i>Éléments changés</h6>
                                                <ul class="list-unstyled ps-3">
                                                    <li>
                                                        <span class="badge {{ vidange.typeChangment is defined and 'huile' in vidange.typeChangment ? 'bg-success' : 'bg-secondary' }} me-2">
                                                            <i class="{{ vidange.typeChangment is defined and 'huile' in vidange.typeChangment ? 'bi bi-check-lg' : 'bi bi-x-lg' }}"></i>
                                                        </span>
                                                        Huile
                                                    </li>
                                                    <li>
                                                        <span class="badge {{ vidange.typeChangment is defined and 'filtre_huile' in vidange.typeChangment ? 'bg-success' : 'bg-secondary' }} me-2">
                                                            <i class="{{ vidange.typeChangment is defined and 'filtre_huile' in vidange.typeChangment ? 'bi bi-check-lg' : 'bi bi-x-lg' }}"></i>
                                                        </span>
                                                        Filtre à huile
                                                    </li>
                                                    <li>
                                                        <span class="badge {{ vidange.typeChangment is defined and 'filtre_gasoil' in vidange.typeChangment ? 'bg-success' : 'bg-secondary' }} me-2">
                                                            <i class="{{ vidange.typeChangment is defined and 'filtre_gasoil' in vidange.typeChangment ? 'bi bi-check-lg' : 'bi bi-x-lg' }}"></i>
                                                        </span>
                                                        Filtre à gasoil
                                                    </li>
                                                    <li>
                                                        <span class="badge {{ vidange.typeChangment is defined and 'filtre_air' in vidange.typeChangment ? 'bg-success' : 'bg-secondary' }} me-2">
                                                            <i class="{{ vidange.typeChangment is defined and 'filtre_air' in vidange.typeChangment ? 'bi bi-check-lg' : 'bi bi-x-lg' }}"></i>
                                                        </span>
                                                        Filtre à air
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-2"><i class="bi bi-calendar-event me-2"></i>Prochaines interventions</h6>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Prochaine vidange</th>
                                                        <th>Prochain filtre à huile</th>
                                                        <th>Prochain filtre à gasoil</th>
                                                        <th>Prochain filtre à air</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>{{ vidange.prochaineVidange ?? vidange.consoProchaineVidange }} km</td>
                                                        <td>{{ vidange.kmFiltreHuile ?? vidange.prochaineFilterChange ?? 'N/A' }} km</td>
                                                        <td>{{ vidange.kmFiltreGasoil ?? 'N/A' }} km</td>
                                                        <td>{{ vidange.kmFiltreAir ?? 'N/A' }} km</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    
                                    {% if vidange.notes is defined and vidange.notes is not empty %}
                                    <div class="mb-0">
                                        <h6 class="text-muted mb-2"><i class="bi bi-chat-square-text me-2"></i>Notes</h6>
                                        <div class="card bg-light">
                                            <div class="card-body py-2 px-3">
                                                {{ vidange.notes }}
                                            </div>
                                        </div>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>Aucune vidange enregistrée
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Section des réparations -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h5 class="mb-0"><i class="bi bi-wrench me-2"></i>Réparations</h5>
                    <button class="btn btn-sm btn-outline-primary" id="addReparationBtn">
                        <i class="bi bi-plus-circle me-1"></i>Ajouter
                    </button>
                </div>
                <div class="card-body">
                    {% if entretien.reparations.count > 0 %}
                        {% for reparation in entretien.reparations %}
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-header bg-light d-flex justify-content-between">
                                    <h6 class="mb-0 fw-bold">Réparation du {{ reparation.date|date('d/m/Y') }}</h6>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-sm btn-outline-primary edit-reparation-btn" data-id="{{ reparation.id }}" data-bs-toggle="tooltip" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger delete-reparation-btn" data-id="{{ reparation.id }}" data-bs-toggle="tooltip" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <h6 class="text-muted mb-2">Description</h6>
                                            <p>{{ reparation.designations }}</p>
                                            
                                            {% if reparation.observation is defined and reparation.observation is not empty %}
                                            <h6 class="text-muted mb-2 mt-3">Observations</h6>
                                            <p>{{ reparation.observation }}</p>
                                            {% endif %}
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="text-muted mb-2">Coût</h6>
                                            <p class="fs-5 fw-bold text-primary">{{ reparation.montantTtc }} DH</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>Aucune réparation enregistrée
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Initialisation des tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
    
    // Redirection vers la page d'édition
    $('#editEntretienBtn').on('click', function() {
        window.location.href = '{{ path("app_entretien_edit", {"id": entretien.id}) }}';
    });
    
    // Gestion du clic sur les boutons d'édition de vidange
    $('.edit-vidange-btn').on('click', function() {
        const vidangeId = $(this).data('id');
        // Rediriger vers une page d'édition ou ouvrir un modal pour éditer cette vidange spécifique
        window.location.href = '{{ path("app_entretien_edit", {"id": entretien.id}) }}';
    });
    
    // Gestion du clic sur les boutons de suppression de vidange
    $('.delete-vidange-btn').on('click', function() {
        const vidangeId = $(this).data('id');
        Swal.fire({
            title: 'Êtes-vous sûr?',
            text: "Cette action est irréversible!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Oui, supprimer!',
            cancelButtonText: 'Annuler'
        }).then((result) => {
            if (result.isConfirmed) {
                // Ici, vous devrez ajouter le code pour supprimer la vidange via une requête AJAX
                Swal.fire(
                    'Supprimé!',
                    'La vidange a été supprimée.',
                    'success'
                );
            }
        });
    });
    
    // Actions similaires pour les réparations
    $('.edit-reparation-btn, .delete-reparation-btn').on('click', function() {
        // Implémenter la logique similaire à celle des vidanges
        window.location.href = '{{ path("app_entretien_edit", {"id": entretien.id}) }}';
    });
    
    // Boutons d'ajout
    $('#addVidangeBtn, #addReparationBtn').on('click', function() {
        // Rediriger vers une page d'ajout ou ouvrir un modal
        window.location.href = '{{ path("app_entretien_edit", {"id": entretien.id}) }}';
    });
});
</script>
{% endblock %}
