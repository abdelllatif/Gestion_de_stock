{% extends 'base.html.twig' %}

{% block title %}Détails de l'Entretien{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container py-5">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 style="color: #232946; font-family: 'Segoe UI', sans-serif; font-weight: bold; letter-spacing: 1px;">
                    <i class="bi bi-tools me-2"></i>Entretien #{{ entretien.numero }}
                </h1>
                <div>
                    <a href="{{ path('app_entretien') }}" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                    </a>
                    <button type="button" class="btn btn-outline-primary" id="editEntretienBtn" data-bs-toggle="tooltip" title="Modifier l'entretien">
                        <i class="bi bi-pencil me-2"></i>Modifier
                    </button>
                </div>
            </div>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title border-bottom pb-2">Informations générales</h5>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong>Numéro d'entretien:</strong> {{ entretien.numero }}</p>
                            <p><strong>Date:</strong> {{ entretien.date|date('d/m/Y') }}</p>
                            <p><strong>Machine:</strong> {{ entretien.machine ? entretien.machine.nom : 'N/A' }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Chantier:</strong> {{ entretien.chantier ? entretien.chantier.nom : 'N/A' }}</p>
                            <p><strong>Mécanicien:</strong> {{ entretien.mecanicien ? entretien.mecanicien.nom : 'N/A' }}</p>
                            <p><strong>Chauffeur:</strong> {{ entretien.chauffeur ? entretien.chauffeur.nom : 'N/A' }}</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Section des réparations -->
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h5 class="mb-0"><i class="bi bi-wrench me-2"></i>Réparations</h5>
                    <button class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle me-1"></i>Ajouter
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Description</th>
                                    <th>Coût</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if entretien.reparations.count > 0 %}
                                    {% for reparation in entretien.reparations %}
                                    <tr>
                                        <td>{{ reparation.designations }}</td>
                                        <td>{{ reparation.montantTtc }}</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center py-3">
                                            <p class="text-muted mb-0">Aucune réparation enregistrée</p>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- Section des vidanges -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h5 class="mb-0"><i class="bi bi-droplet me-2"></i>Vidanges</h5>
                    <button class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-circle me-1"></i>Ajouter
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type d'huile</th>
                                    <th>Quantité</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if entretien.vidanges.count > 0 %}
                                    {% for vidange in entretien.vidanges %}
                                    <tr>
                                        <td>{{ vidange.typeChangment }}</td>
                                        <td>{{ vidange.consomation }}</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center py-3">
                                            <p class="text-muted mb-0">Aucune vidange enregistrée</p>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Initialisation des tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
    
    // Redirection vers la page d'édition
    $('#editEntretienBtn').on('click', function() {
        window.location.href = '{{ path("app_entretien_edit", {"id": entretien.id}) }}';
    });
});
</script>
{% endblock %}
