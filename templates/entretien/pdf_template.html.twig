<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Entretien #{{ entretien.numero }}</title>
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 11px;
            color: #333333;
            line-height: 1.3;
        }
        .container {
            width: 100%;
            padding: 5mm;
        }
        .header {
            text-align: center;
            margin-bottom: 5mm;
            padding-top: 5mm;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 3mm;
        }
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10mm;
            border-bottom: 1px solid #e5e7eb;
        }
        h1 {
            color: #1e3a8a;
            font-size: 16px;
            margin-bottom: 3mm;
            margin-top: 0;
        }
        h2 {
            color: #3b82f6;
            font-size: 13px;
            margin-top: 5mm;
            margin-bottom: 3mm;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 1mm;
        }
        .info-block {
            border: 1px solid #e5e7eb;
            border-radius: 3px;
            padding: 3mm;
            margin-bottom: 3mm;
        }
        .info-row {
            margin-bottom: 1mm;
        }
        .info-label {
            font-weight: bold;
            width: 40%;
            float: left;
        }
        .info-value {
            width: 60%;
            float: left;
        }
        .clearfix::after {
            content: "";
            clear: both;
            display: table;
        }
        .badge {
            display: inline-block;
            padding: 1mm 2mm;
            border-radius: 2mm;
            color: white;
            font-size: 10px;
        }
        .badge-success {
            background-color: #10b981;
        }
        .badge-danger {
            background-color: #ef4444;
        }
        .badge-warning {
            background-color: #f59e0b;
        }
        .badge-vidange {
            background-color: #3b82f6;
        }
        .badge-reparation {
            background-color: #8b5cf6;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 3mm;
            margin-bottom: 3mm;
        }
        th {
            background-color: #f3f4f6;
            border: 1px solid #ddd;
            padding: 1.5mm;
            text-align: left;
            font-weight: bold;
        }
        td {
            border: 1px solid #ddd;
            padding: 1.5mm;
        }
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 3mm;
        }
        .info-table th {
            background-color: #f3f4f6;
            border: 1px solid #ddd;
            padding: 2mm;
            text-align: left;
            font-weight: bold;
            font-size: 11px;
        }
        .info-table td {
            border: 1px solid #ddd;
            padding: 2mm;
            font-size: 11px;
            vertical-align: middle;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
        }
        .details-table th {
            background-color: #f3f4f6;
            border: 1px solid #ddd;
            padding: 2mm;
            font-weight: bold;
            font-size: 11px;
        }
        .details-table td {
            border: 1px solid #ddd;
            padding: 2mm;
            font-size: 11px;
            vertical-align: middle;
        }
        .no-border {
            border: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .text-right {
            text-align: right;
        }
        .total-row {
            font-weight: bold;
        }
        .footer {
            margin-top: 5mm;
            text-align: center;
            font-size: 9px;
            color: #6b7280;
            border-top: 1px solid #e5e7eb;
            padding-top: 2mm;
        }
        .footer-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10mm;
            border-top: 1px solid #e5e7eb;
        }
        .page-number {
            text-align: center;
            font-size: 9px;
            color: #6b7280;
            margin-top: 2mm;
        }
        .section {
            margin-bottom: 5mm;
        }
        .item-card {
            border: 1px solid #e5e7eb;
            border-radius: 3px;
            padding: 2mm;
            margin-bottom: 3mm;
        }
        .note-section {
            margin-top: 3mm;
            padding: 2mm;
            background-color: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 3px;
        }
        .centered {
            text-align: center;
        }
        .item-header {
            background-color: #f3f4f6;
            padding: 1.5mm;
            font-weight: bold;
            margin-bottom: 1mm;
        }
        .item-body {
            padding: 1mm;
        }
        .columns {
            display: table;
            width: 100%;
        }
        .column {
            display: table-cell;
            width: 50%;
            padding-right: 2mm;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Logo et titre en haut au centre -->
        <table class="header-table">
            <tr>
                <td style="text-align: center; padding-bottom: 3mm;">
                    <h1 style="color: #1e3a8a; margin-bottom: 0;">MATÉRIELLES ET LOGISTIQUE</h1>
                    <p style="color: #3b82f6; font-size: 10px; margin-top: 2mm;">GESTION DE STOCK</p>
                    <h1 style="margin-top: 5mm;">Fiche d'Entretien #{{ entretien.numero }}</h1>
                    <p style="margin-top: 2mm;">Document généré le: {{ "now"|date("d/m/Y") }}</p>
                </td>
            </tr>
        </table>
        
        <h2>Informations générales</h2>
        <table class="info-table">
            <tr>
                <th width="16.67%">Numéro d'entretien</th>
                <th width="16.67%">Date</th>
                <th width="16.67%">Machine</th>
                <th width="16.67%">Chauffeur</th>
                <th width="16.67%">Mécanicien</th>
                <th width="16.67%">Chantier</th>
            </tr>
            <tr>
                <td>{{ entretien.numero }}</td>
                <td>{{ dateFormattee }}</td>
                <td>{{ machine }}</td>
                <td>{{ chauffeur }}</td>
                <td>{{ mecanicien }}</td>
                <td>{{ chantier }}</td>
            </tr>
        </table>
        
        <h2>Vidanges</h2>
        
        {% if vidanges|length > 0 %}
            {% for vidange in vidanges %}
                <table class="details-table">
                    <thead>
                        <tr>
                            <th colspan="4" style="background-color: #edf2f7;">
                                <span class="badge badge-vidange">Vidange</span>
                                Vidange du {{ vidange.date }}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td width="25%" style="font-weight: bold;">Kilométrage actuel</td>
                            <td width="25%">{{ vidange.kilometre }} km</td>
                            <td width="25%" style="font-weight: bold;">Prochaine vidange</td>
                            <td width="25%">{{ vidange.prochaineVidange }} km</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">Montant TTC</td>
                            <td>{{ vidange.montantTtc }} DH</td>
                            <td style="font-weight: bold;">Prochain filtre huile</td>
                            <td>{{ vidange.kmFiltreHuile }} km</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">Type de changement</td>
                            <td>{{ vidange.typeChangment }}</td>
                            <td style="font-weight: bold;">Prochain filtre gasoil</td>
                            <td>{{ vidange.kmFiltreGasoil }} km</td>
                        </tr>
                        <tr>
                            <td style="font-weight: bold;">Consommation</td>
                            <td>{{ vidange.consomation }} L</td>
                            <td style="font-weight: bold;">Prochain filtre air</td>
                            <td>{{ vidange.kmFiltreAir }} km</td>
                        </tr>
                        {% if vidange.notes %}
                        <tr>
                            <td style="font-weight: bold; background-color: #f8f9fa;">Notes</td>
                            <td colspan="3" style="background-color: #f8f9fa;">{{ vidange.notes }}</td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
                <div style="margin-bottom: 5mm;"></div>
            {% endfor %}
        {% else %}
            <table class="info-table">
                <tr>
                    <td style="text-align: center; font-style: italic; color: #6b7280;">
                        Aucune vidange enregistrée pour cet entretien.
                    </td>
                </tr>
            </table>
        {% endif %}
        
        <h2>Réparations</h2>
        
        {% if reparations|length > 0 %}
            {% for reparation in reparations %}
                <table class="details-table">
                    <thead>
                        <tr>
                            <th colspan="2" style="background-color: #edf2f7;">
                                <span class="badge badge-reparation">Réparation</span>
                                Réparation du {{ reparation.date }}
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td width="20%" style="font-weight: bold; vertical-align: top;">Désignations</td>
                            <td width="80%">{{ reparation.designations }}</td>
                        </tr>
                        {% if reparation.observation %}
                        <tr>
                            <td style="font-weight: bold; vertical-align: top;">Observations</td>
                            <td>{{ reparation.observation }}</td>
                        </tr>
                        {% endif %}
                        <tr>
                            <td style="font-weight: bold; vertical-align: top;">Coût</td>
                            <td style="font-weight: bold; color: #2563eb;">{{ reparation.montantTtc }} DH</td>
                        </tr>
                    </tbody>
                </table>
                <div style="margin-bottom: 5mm;"></div>
            {% endfor %}
        {% else %}
            <table class="info-table">
                <tr>
                    <td style="text-align: center; font-style: italic; color: #6b7280;">
                        Aucune réparation enregistrée pour cet entretien.
                    </td>
                </tr>
            </table>
        {% endif %}
        
        {% if entretien.note is defined and entretien.note %}
            <h2>Notes</h2>
            <table class="info-table">
                <tr>
                    <td style="background-color: #f8f9fa;">
                        <p style="margin: 0;">{{ entretien.note|nl2br }}</p>
                    </td>
                </tr>
            </table>
        {% endif %}
        
        <table class="footer-table">
            <tr>
                <td style="text-align: center; font-size: 9px; color: #6b7280; padding-top: 5mm;">
                    Document généré le {{ "now"|date("d/m/Y à H:i") }} - Gestion des Matérielles
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
