<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Demande d'Achat #{{ demande.id }}</title>
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 11px;
            color: #333333;
            line-height: 1.3;
        }
        .container {
            width: 100%;
            padding: 5mm;
        }
        .header {
            text-align: center;
            margin-bottom: 5mm;
            padding-top: 5mm;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 3mm;
        }
        h1 {
            color: #1e3a8a;
            font-size: 16px;
            margin-bottom: 3mm;
            margin-top: 0;
        }
        h2 {
            color: #3b82f6;
            font-size: 13px;
            margin-top: 5mm;
            margin-bottom: 3mm;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 1mm;
        }
        .info-block {
            border: 1px solid #e5e7eb;
            border-radius: 3px;
            padding: 3mm;
            margin-bottom: 3mm;
        }
        .info-row {
            margin-bottom: 1mm;
        }
        .info-label {
            font-weight: bold;
            width: 40%;
        }
        .info-value {
            width: 60%;
        }
        .header-table, .info-table, .footer-table {
            border-collapse: collapse;
            width: 100%;
        }
        .header-table td, .footer-table td {
            padding: 3px;
            border: none;
        }
        .info-table td {
            padding: 3px;
            border: none;
            vertical-align: top;
        }
        .badge {
            display: inline-block;
            padding: 1mm 2mm;
            border-radius: 2mm;
            color: white;
            font-size: 10px;
        }
        .badge-success {
            background-color: #10b981;
        }
        .badge-danger {
            background-color: #ef4444;
        }
        .badge-warning {
            background-color: #f59e0b;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 3mm;
            margin-bottom: 3mm;
        }
        th {
            background-color: #f3f4f6;
            border: 1px solid #ddd;
            padding: 1.5mm;
            text-align: left;
            font-weight: bold;
        }
        td {
            border: 1px solid #ddd;
            padding: 1.5mm;
        }
        .text-right {
            text-align: right;
        }
        .total-row {
            font-weight: bold;
        }
        .footer {
            margin-top: 5mm;
            text-align: center;
            font-size: 9px;
            color: #6b7280;
            border-top: 1px solid #e5e7eb;
            padding-top: 2mm;
        }
        .page-number {
            text-align: center;
            font-size: 9px;
            color: #6b7280;
            margin-top: 2mm;
        }
        .note-section {
            margin-top: 3mm;
            padding: 2mm;
            background-color: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 3px;
        }
        .centered {
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header with table layout -->
        <div class="header">
            <table class="header-table" width="100%">
                <tr>
                    <td class="centered">
                        <h1 style="color: #1e3a8a; margin-bottom: 0;">MATÉRIELLES ET LOGISTIQUE</h1>
                        <p style="color: #3b82f6; font-size: 10px; margin-top: 2mm;">GESTION DE STOCK</p>
                    </td>
                </tr>
                <tr>
                    <td class="centered">
                        <h1>Demande d'Achat #{{ demande.id }}</h1>
                        <p>Document généré le: {{ "now"|date("d/m/Y") }}</p>
                    </td>
                </tr>
            </table>
        </div>
        
        <div class="info-block">
            <h2>Informations de la demande</h2>
            
            <table class="info-table" width="100%">
                <tr>
                    <td width="40%" class="info-label">Numéro de demande:</td>
                    <td width="60%" class="info-value">{{ demande.id }}</td>
                </tr>
                <tr>
                    <td class="info-label">Date de la demande:</td>
                    <td class="info-value">{{ dateFormattee }}</td>
                </tr>
                <tr>
                    <td class="info-label">État:</td>
                    <td class="info-value">
                        {% if demande.etat == 'Approuvée' %}
                            <span class="badge badge-success">{{ demande.etat }}</span>
                        {% elseif demande.etat == 'Rejetée' %}
                            <span class="badge badge-danger">{{ demande.etat }}</span>
                        {% else %}
                            <span class="badge badge-warning">{{ demande.etat }}</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td class="info-label">Demandeur:</td>
                    <td class="info-value">{{ userName }}</td>
                </tr>
            </table>
        </div>
        
        <div class="info-block">
            <h2>Résumé financier</h2>
            
            <table class="info-table" width="100%">
                <tr>
                    <td width="40%" class="info-label">Montant HT:</td>
                    <td width="60%" class="info-value">{{ demande.montantHT|number_format(2, ',', ' ') }} DH</td>
                </tr>
                <tr>
                    <td class="info-label">TVA ({{ demande.tva }}%):</td>
                    <td class="info-value">{{ (demande.montantHT * demande.tva / 100)|number_format(2, ',', ' ') }} DH</td>
                </tr>
                <tr style="border-top: 1px solid #e5e7eb;">
                    <td class="info-label" style="font-size: 13px; font-weight: bold; padding-top: 1mm;">Montant TTC:</td>
                    <td class="info-value" style="font-size: 13px; font-weight: bold; color: #dc2626; padding-top: 1mm;">
                        {{ demande.montantTTC|number_format(2, ',', ' ') }} DH
                    </td>
                </tr>
            </table>
        </div>
        
        {% if details|length > 0 %}
            <h2>Détails des articles</h2>
            <table>
                <thead>
                    <tr>
                        <th width="40%">Article</th>
                        <th width="15%" class="text-right">Quantité</th>
                        <th width="20%" class="text-right">Prix unitaire (DH)</th>
                        <th width="25%" class="text-right">Total (DH)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for detail in details %}
                        <tr>
                            <td>
                                <strong>{{ detail.article.nom }}</strong><br>
                                <small>Réf: {{ detail.article.reference }}</small>
                            </td>
                            <td class="text-right">{{ detail.quantite }}</td>
                            <td class="text-right">{{ detail.prixUnitaire|number_format(2, ',', ' ') }}</td>
                            <td class="text-right">{{ detail.prixTotal|number_format(2, ',', ' ') }}</td>
                        </tr>
                    {% endfor %}
                    <tr class="total-row">
                        <td colspan="3" class="text-right">Total HT:</td>
                        <td class="text-right">{{ demande.montantHT|number_format(2, ',', ' ') }} DH</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-right">TVA ({{ demande.tva }}%):</td>
                        <td class="text-right">{{ (demande.montantHT * demande.tva / 100)|number_format(2, ',', ' ') }} DH</td>
                    </tr>
                    <tr class="total-row">
                        <td colspan="3" class="text-right">Total TTC:</td>
                        <td class="text-right" style="color: #dc2626;">{{ demande.montantTTC|number_format(2, ',', ' ') }} DH</td>
                    </tr>
                </tbody>
            </table>
        {% else %}
            <div class="info-block" style="text-align: center; font-style: italic; color: #6b7280;">
                Aucun article dans cette demande d'achat.
            </div>
        {% endif %}
        
        {% if demande.description is defined and demande.description %}
            <div class="note-section">
                <table width="100%">
                    <tr>
                        <td style="font-weight: bold; padding-bottom: 2mm;">Description :</td>
                    </tr>
                    <tr>
                        <td>{{ demande.description|nl2br }}</td>
                    </tr>
                </table>
            </div>
        {% endif %}
        
        <div class="footer">
            <table class="footer-table" width="100%">
                <tr>
                    <td class="centered">
                        Document généré le {{ "now"|date("d/m/Y à H:i") }} - Gestion des Matérielles
                    </td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>
