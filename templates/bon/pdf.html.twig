<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Bon #{{ bon.numeroSerie }}</title>
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 11px;
            color: #333333;
            line-height: 1.3;
        }
        .container {
            width: 100%;
            padding: 5mm;
        }
        .header {
            text-align: center;
            margin-bottom: 5mm;
            padding-top: 5mm;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 3mm;
        }
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10mm;
            border-bottom: 1px solid #e5e7eb;
        }
        h1 {
            color: #1e3a8a;
            font-size: 16px;
            margin-bottom: 3mm;
            margin-top: 0;
        }
        h2 {
            color: #3b82f6;
            font-size: 13px;
            margin-top: 5mm;
            margin-bottom: 3mm;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 1mm;
        }
        .info-block {
            border: 1px solid #e5e7eb;
            border-radius: 3px;
            padding: 3mm;
            margin-bottom: 3mm;
        }
        .info-row {
            margin-bottom: 1mm;
        }
        .info-label {
            font-weight: bold;
            width: 40%;
            float: left;
        }
        .info-value {
            width: 60%;
            float: left;
        }
        .clearfix::after {
            content: "";
            clear: both;
            display: table;
        }
        .badge {
            display: inline-block;
            padding: 1mm 2mm;
            border-radius: 2mm;
            color: white;
            font-size: 10px;
        }
        .badge-article {
            background-color: #3b82f6;
        }
        .badge-machine {
            background-color: #8b5cf6;
        }
        .badge-sortie {
            background-color: #ef4444;
        }
        .badge-entree {
            background-color: #10b981;
        }
        .badge-livraison {
            background-color: #f59e0b;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 3mm;
            margin-bottom: 3mm;
        }
        th {
            background-color: #f3f4f6;
            border: 1px solid #ddd;
            padding: 1.5mm;
            text-align: left;
            font-weight: bold;
        }
        td {
            border: 1px solid #ddd;
            padding: 1.5mm;
        }
        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 3mm;
        }
        .info-table th {
            background-color: #f3f4f6;
            border: 1px solid #ddd;
            padding: 2mm;
            text-align: left;
            font-weight: bold;
            font-size: 11px;
        }
        .info-table td {
            border: 1px solid #ddd;
            padding: 2mm;
            font-size: 11px;
            vertical-align: middle;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
        }
        .details-table th {
            background-color: #f3f4f6;
            border: 1px solid #ddd;
            padding: 2mm;
            font-weight: bold;
            font-size: 11px;
        }
        .details-table td {
            border: 1px solid #ddd;
            padding: 2mm;
            font-size: 11px;
            vertical-align: middle;
        }
        .no-border {
            border: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .footer {
            margin-top: 5mm;
            text-align: center;
            font-size: 9px;
            color: #6b7280;
            border-top: 1px solid #e5e7eb;
            padding-top: 2mm;
        }
        .footer-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10mm;
            border-top: 1px solid #e5e7eb;
        }
        .page-number {
            text-align: center;
            font-size: 9px;
            color: #6b7280;
            margin-top: 2mm;
        }
        .note-section {
            margin-top: 3mm;
            padding: 2mm;
            background-color: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 3px;
        }
        .centered {
            text-align: center;
        }
  
    </style>
</head>
<body>
    <div class="container">
        <!-- Logo et titre en haut au centre -->
        <table class="header-table">
            <tr>
                <td style="text-align: center; padding-bottom: 3mm;">
                    <h1 style="color: #1e3a8a; margin-bottom: 0;">MATÉRIELLES ET LOGISTIQUE</h1>
                    <p style="color: #3b82f6; font-size: 10px; margin-top: 2mm;">GESTION DE STOCK</p>
                    <h1 style="margin-top: 5mm;">Bon {{ bon.type|upper }} #{{ bon.numeroSerie }}</h1>
                    <p style="margin-top: 2mm;">Document généré le: {{ "now"|date("d/m/Y") }}</p>
                </td>
            </tr>
        </table>
        
        <h2>Informations du Bon</h2>
        <table class="info-table">
            <tr>
                <th width="30%">Type</th>
                <th width="20%">Numéro de série</th>
                <th width="25%">Date</th>
                <th width="25%">Chantier</th>
            </tr>
            <tr>
                <td>
                    {% if bon.type == 'Sortie' %}
                        <span class="badge badge-sortie">{{ bon.type }}</span>
                    {% elseif bon.type == 'Entrée' %}
                        <span class="badge badge-entree">{{ bon.type }}</span>
                    {% elseif bon.type == 'Livraison' %}
                        <span class="badge badge-livraison">{{ bon.type }}</span>
                    {% else %}
                        {{ bon.type }}
                    {% endif %}
                </td>
                <td>{{ bon.numeroSerie }}</td>
                <td>{{ bon.date|date('d/m/Y') }}</td>
                <td>{{ bon.chantier ? bon.chantier.nom : 'Non assigné' }}</td>
            </tr>
        </table>
        
        <!-- Fournisseur si disponible -->
        {% set hasFournisseur = false %}
        {% for detail in bon.bonDetails %}
            {% if detail.fournisseur is defined and detail.fournisseur and not hasFournisseur %}
                {% set hasFournisseur = true %}
                <table class="info-table" style="margin-top: 3mm;">
                    <tr>
                        <th width="30%">Fournisseur principal</th>
                        <td width="70%">{{ detail.fournisseur }}</td>
                    </tr>
                </table>
            {% endif %}
        {% endfor %}

        <h2>Détails des Articles et Machines</h2>
        
        {% if bon.bonDetails|length > 0 %}
            <table class="details-table">
                <thead>
                    <tr>
                        <th width="15%" style="text-align: center;">Type</th>
                        <th width="40%">Désignation</th>
                        <th width="15%" style="text-align: center;">Quantité</th>
                        <th width="15%" style="text-align: center;">Unité</th>
                        {% if bon.type == 'Livraison' %}
                            <th width="15%" style="text-align: center;">Fournisseur</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for detail in bon.bonDetails %}
                        <tr>
                            <td style="text-align: center;">
                                {% if detail.article %}
                                    <span class="badge badge-article">Article</span>
                                {% elseif detail.machine %}
                                    <span class="badge badge-machine">Machine</span>
                                {% endif %}
                            </td>
                            <td>
                                <table class="no-border">
                                    <tr>
                                        <td class="no-border"><strong>{{ detail.article ? detail.article.nom : detail.machine.nom }}</strong></td>
                                    </tr>
                                    <tr>
                                        <td class="no-border" style="color: #6b7280; font-size: 9px;">
                                            {% if detail.article %}
                                                Réf: {{ detail.article.reference }}
                                            {% elseif detail.machine and detail.machine.code %}
                                                Code: {{ detail.machine.code }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="text-align: center;">{{ detail.quantite }}</td>
                            <td style="text-align: center;">{{ detail.unite|default('-') }}</td>
                            {% if bon.type == 'Livraison' %}
                                <td style="text-align: center;">{{ detail.fournisseur|default('-') }}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <table class="info-table">
                <tr>
                    <td style="text-align: center; font-style: italic; color: #6b7280;">
                        Aucun élément dans ce bon.
                    </td>
                </tr>
            </table>
        {% endif %}
        
        {% if bon.note %}
            <h2>Notes</h2>
            <table class="info-table">
                <tr>
                    <td style="background-color: #f8f9fa;">
                        <p style="margin: 0;">{{ bon.note|nl2br }}</p>
                    </td>
                </tr>
            </table>
        {% endif %}
        
        <table class="footer-table">
            <tr>
                <td style="text-align: center; font-size: 9px; color: #6b7280; padding-top: 5mm;">
                    Document généré le {{ "now"|date("d/m/Y à H:i") }} - Gestion des Matérielles
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
