{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('unauthorized')) {
            Swal.fire({
                icon: 'error',
                title: 'Accès refusé',
                text: 'Vous n\'avez pas la permission d\'effectuer cette action.',
                confirmButtonText: 'OK'
            });
        }
    });
</script>
<div class="container py-5">
    <h1 class="mb-5 text-center" style="color: #232946; font-family: 'Segoe UI', sans-serif; font-weight: bold; letter-spacing: 1px;">
        Bienvenue sur votre Tableau de bord
    </h1>
    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm dashboard-card" style="border: none; transition: transform 0.2s;">
                <div class="card-body text-center">
                    <i class="bi bi-gear display-4 text-primary mb-3"></i>
                    <h5 class="card-title">entretien</h5>
                    <p class="card-text text-muted">Gérer les entretiens des machines</p>
                    <a href="/entretien" class="btn btn-outline-primary w-100">Accéder</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm dashboard-card" style="border: none; transition: transform 0.2s;">
                <div class="card-body text-center">
                    <i class="bi bi-arrow-left-right display-4 text-info mb-3"></i>

                    <h5 class="card-title">Mouvements de stock</h5>
                    <p class="card-text text-muted">Suivre les mouvements de stock</p>
                    <a href="/stock/movement" class="btn btn-outline-info w-100">Accéder</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm dashboard-card" style="border: none; transition: transform 0.2s;">
                <div class="card-body text-center">
                    <i class="bi bi-boxes display-4 text-success mb-3"></i>

                    <h5 class="card-title">Stock</h5>
                    <p class="card-text text-muted">Consulter et augmenter des stock pour les chantier</p>
                    <a href="/stock" class="btn btn-outline-success w-100">Accéder</a>
                </div>
            </div>
        </div>
        



        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm dashboard-card" style="border: none; transition: transform 0.2s;">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-text display-4 text-secondary mb-3"></i>
                    <h5 class="card-title">Bons</h5>
                    <p class="card-text text-muted">Gérer les bons</p>
                    <a href="/bon" class="btn btn-outline-secondary w-100">Accéder</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}