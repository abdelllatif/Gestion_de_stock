{% extends 'base.html.twig' %}

{% block title %}Stock par Chantier{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0" style="color: #232946; font-family: 'Segoe UI', sans-serif; font-weight: bold; letter-spacing: 1px;">
                Stock du Chantier: {{ chantier_nom }}
            </h1>
        </div>
        <a href="{{ path('stock_export_excel') }}" class="btn btn-success d-flex align-items-center" style="background: linear-gradient(90deg, #22c55e, #16a34a); font-weight: 500; border: none;">
            <i class="bi bi-file-earmark-excel me-2"></i>  Excel
        </a>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped mb-0" id="stockTable">
                <thead class="table-light">
                    <tr>
                        <th>Chantier/Dépôt</th>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Catégorie</th>
                        <th>Quantité</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                {% if stocks is empty %}
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <div>
                                <i class="bi bi-box text-muted" style="font-size: 2rem;"></i>
                                <div class="mt-2 mb-2" style="color: #232946;">Aucun stock dans ce chantier</div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {% for stock in stocks %}
                        <tr>
                            <td>{{ chantier_nom }}</td>
                            <td>
                                {% if stock.article %}
                                    {{ stock.article.nom }}
                                {% elseif stock.machine %}
                                    {{ stock.machine.nom }}
                                {% endif %}
                            </td>
                            <td>
                                {% if stock.article %}Article{% elseif stock.machine %}Machine{% endif %}
                            </td>
                            <td>
                                {% if stock.article and stock.article.getCategory() %}
                                    {{ stock.article.getCategory().getNom() }}
                                {% elseif stock.machine and stock.machine.getCategorie() %}
                                    {{ stock.machine.getCategorie().getNom() }}
                                {% else %}-{% endif %}
                            </td>
                            <td>
                                {{ stock.getQuantiteChantier() }}
                            </td>
                            <td>
                                {% if stock.article %}
                                    Bon: {{ stock.getBonEtat() }}, Mauvais: {{ stock.getMauvaisEtat() }}, Ferraille: {{ stock.getFerailleEtat() }}
                                {% else %}-{% endif %}
                            </td>
                            <td>
                                <button class="btn btn-outline-primary btn-sm add-qty-btn" 
                                    data-id="{{ stock.article ? stock.article.id : stock.machine.id }}"
                                    data-type="{{ stock.article ? 'article' : 'machine' }}"
                                    data-nom="{{ stock.article ? stock.article.nom : stock.machine.nom }}">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Ajouter Quantité -->
<div class="modal fade" id="addQtyModal" tabindex="-1" aria-labelledby="addQtyModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header" style="background: linear-gradient(90deg, #1e3a8a, #3b82f6); color: white;">
        <h5 class="modal-title" id="addQtyModalLabel"><i class="bi bi-plus-circle me-2"></i>Ajouter quantité</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addQtyForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nom</label>
            <input type="text" class="form-control" id="modalNom" readonly>
          </div>
          <div class="mb-3">
            <label for="modalQuantite" class="form-label">Quantité</label>
            <input type="number" class="form-control" id="modalQuantite" name="quantite" min="1" required>
          </div>
          <div class="mb-3">
            <label for="modalFournisseur" class="form-label">Fournisseur</label>
            <input type="text" class="form-control" id="modalFournisseur" name="fournisseur" required>
          </div>
          <input type="hidden" id="modalId" name="id">
          <input type="hidden" id="modalType" name="type">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-md" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary btn-md" id="addQtySubmit" style="background: linear-gradient(90deg, #1e3a8a, #3b82f6); border: none;"><i class="bi bi-save me-1"></i>Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.7/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
$(function() {
    // DataTable initialization (copied from utilisateur page for consistency)
    var table = $('#stockTable').DataTable({
        language: {
            url: 'https://cdn.datatables.net/plug-ins/2.0.7/i18n/fr-FR.json'
        },
        responsive: true,
        pageLength: 10,
        lengthChange: true,
        info: true,
        searching: true,
        order: [[0, 'asc']],
        columnDefs: [
            {
                targets: [6], // Action column
                orderable: false,
                searchable: false
            }
        ],
        dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
             "<'row'<'col-sm-12'tr>>" +
             "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
    });

    // Style the search box like utilisateur page
    let searchBox = $(table.table().container()).find('div.dataTables_filter input');
    searchBox.addClass('form-control ps-5').attr('placeholder', 'Rechercher dans le stock...');
    searchBox.wrap('<div class="position-relative"></div>');
    searchBox.before('<span class="position-absolute top-50 start-0 translate-middle-y ps-3" style="pointer-events:none;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-search text-secondary" viewBox="0 0 16 16"><path d="M11 6a5 5 0 1 1-10 0 5 5 0 0 1 10 0zm-1.293 6.707a6 6 0 1 0-1.414 1.414l3.85 3.85a1 1 0 0 0 1.415-1.415l-3.85-3.85z"/></svg></span>');
    searchBox.css({ paddingLeft: '2.5rem', marginBottom: '0.5rem', maxWidth: '300px' });

    // Hover effect for table rows
    $('#stockTable tbody').on('mouseenter', 'tr', function() {
        $(this).addClass('table-hover-effect');
    }).on('mouseleave', 'tr', function() {
        $(this).removeClass('table-hover-effect');
    });

    var addQtyModal = new bootstrap.Modal(document.getElementById('addQtyModal'));
    $('.add-qty-btn').on('click', function() {
        var id = $(this).data('id');
        var type = $(this).data('type');
        var nom = $(this).data('nom');
        $('#modalId').val(id);
        $('#modalType').val(type);
        $('#modalNom').val(nom);
        $('#modalQuantite').val('');
        $('#modalFournisseur').val('');
        addQtyModal.show();
    });
    $('#addQtyForm').on('submit', function(e) {
        e.preventDefault();
        var $btn = $('#addQtySubmit');
        $btn.prop('disabled', true).text('Chargement...');
        var data = {
            id: $('#modalId').val(),
            type: $('#modalType').val(),
            quantite: $('#modalQuantite').val(),
            fournisseur: $('#modalFournisseur').val(),
            chantier_nom: '{{ chantier_nom|e('js') }}'
        };
        $.ajax({
            url: '{{ path('stock_ajouter_quantite') }}',
            method: 'POST',
            data: data,
            success: function(response) {
                Swal.fire({
                    icon: 'success',
                    title: 'Succès',
                    text: 'Quantité ajoutée avec succès!',
                    timer: 2000,
                    showConfirmButton: false,
                    timerProgressBar: true
                });
                addQtyModal.hide();
                setTimeout(function() { location.reload(); }, 1000);
            },
            error: function(xhr) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Erreur lors de l\'ajout de la quantité.',
                    timer: 3500,
                    showConfirmButton: false,
                    timerProgressBar: true
                });
            },
            complete: function() {
                $btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Enregistrer');
            }
        });
    });
});
</script>
<style>
.table-hover-effect {
    background-color: #f8f9fa !important;
    transform: scale(1.01);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: all 0.2s ease;
}
.dataTables_wrapper .dataTables_length select {
    padding: 0.375rem 2.25rem 0.375rem 0.75rem;
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
}
.dataTables_wrapper .dataTables_info {
    padding-top: 0.75rem;
    font-size: 0.875rem;
    color: #6c757d;
}
.dataTables_wrapper .dataTables_paginate .paginate_button {
    padding: 0.375rem 0.75rem;
    margin: 0 0.125rem;
    border-radius: 0.375rem;
    border: 1px solid #dee2e6;
    background: #fff;
}
.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
    background: #e9ecef;
}
.dataTables_wrapper .dataTables_paginate .paginate_button.current {
    background: linear-gradient(90deg, #1e3a8a, #3b82f6);
    color: white !important;
    border-color: #1e3a8a;
}
.form-control:focus, .form-select:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
}
</style>
{% endblock %}
