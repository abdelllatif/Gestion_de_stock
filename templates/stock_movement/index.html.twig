{% extends 'base.html.twig' %}

{% block title %}Mouvements de stock{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.7/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0" style="color: #232946; font-family: 'Segoe UI', sans-serif; font-weight: bold; letter-spacing: 1px;">Mouvements de stock</h1>
        <div class="d-flex align-items-center gap-2">
            <form id="exportExcelForm" method="get" action="{{ path('stock_movement_export_excel') }}" class="d-flex align-items-center gap-2 mb-0">
                <input type="date" class="form-control" name="start_date" id="start_date" value="{{ app.request.get('start_date') }}" style="max-width: 170px;">
                <input type="date" class="form-control" name="end_date" id="end_date" value="{{ app.request.get('end_date') }}" style="max-width: 170px;">
                <button type="submit" class="btn btn-success d-flex align-items-center" style="background: linear-gradient(90deg, #22c55e, #16a34a); font-weight: 500; border: none;">
                    <i class="bi bi-file-earmark-excel me-2"></i>  Excel
                </button>
            </form>
            <button class="btn btn-primary" style="background: linear-gradient(90deg, #1e3a8a, #3b82f6); font-weight: 500; border: none;" data-bs-toggle="modal" data-bs-target="#addMovementModal">Ajouter un mouvement</button>
        </div>
    </div>
    <div class="card shadow-sm p-4">
        <table id="stockMovementsTable" class="table table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Article/Machine</th>
                    <th>Quantité</th>
                    <th>Dépôt/Chantier</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% if mouvements is empty %}
                    <tr>
                        <td colspan="7" class="text-center">Aucun mouvement de stock trouvé.</td>
                    </tr>
                {% else %}
                    {% for mouvement in mouvements %}
                        <tr>
                            <td>{{ mouvement.displayType }}</td>
                            <td>{{ mouvement.date ? mouvement.date|date('Y-m-d') : '' }}</td>
                            <td>
                                {% if mouvement.article %}
                                    {{ mouvement.article.nom }}
                                {% elseif mouvement.machine %}
                                    {{ mouvement.machine.nom }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>{{ mouvement.quantite }}</td>
                            <td>
                                {% if mouvement.chantierRec %}
                                    {{ mouvement.chantierRec.nom }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                {% if mouvement.status == 'valid' %}
                                    <i class="bi bi-check-circle text-success"></i> Validé
                                {% elseif mouvement.status == 'rejected' %}
                                    <i class="bi bi-x-circle text-danger"></i> Rejeté
                                {% else %}
                                    <i class="bi bi-hourglass-split text-warning"></i> En attente
                                {% endif %}
                            </td>
                            <td>
                                {% if mouvement.canEdit %}
                                    {% if mouvement.status == 'waiting' %}
                                        <button class="btn btn-sm btn-outline-success" onclick="changeStatus({{ mouvement.id }}, 'valid')"><i class="bi bi-check-circle"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="changeStatus({{ mouvement.id }}, 'rejected')"><i class="bi bi-x-circle"></i></button>
                                    {% endif %}
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMovementModal" data-id="{{ mouvement.id }}" data-item-id="{{ mouvement.article ? mouvement.article.id : (mouvement.machine ? mouvement.machine.id : '') }}" data-item-name="{{ mouvement.article ? mouvement.article.nom : (mouvement.machine ? mouvement.machine.nom : '') }}" data-item-type="{{ mouvement.article ? 'article' : (mouvement.machine ? 'machine' : '') }}"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="showDeleteAlert('Êtes-vous sûr de vouloir supprimer ce mouvement ?', {{ mouvement.id }})"><i class="bi bi-trash"></i></button>
                                {% else %}
                                    <span class="text-muted">En attente (hors chantier)</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Ajout Mouvement -->
<div class="modal fade" id="addMovementModal" tabindex="-1" aria-labelledby="addMovementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #1e3a8a, #3b82f6); color: white;">
                <h5 class="modal-title" id="addMovementModalLabel"><i class="bi bi-plus-circle me-2"></i>Ajouter un mouvement de stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form id="addMovementForm">
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="type" class="form-label">Type de mouvement</label>
                            <select class="form-select" id="type" name="type" required>
                                <option value="">Sélectionner...</option>
                                <option value="Transfert">Transfert</option>
                                <option value="Augmenter stock">Augmenter stock</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="itemType" class="form-label">Type d'élément</label>
                            <select class="form-select" id="itemType" name="itemType">
                                <option value="">Sélectionner...</option>
                                <option value="article">Article</option>
                                <option value="machine">Machine</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="itemId" class="form-label">Article/Machine</label>
                            <select class="form-select" id="itemId" name="itemId" required>
                                <option value="">Sélectionner...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="quantite" class="form-label">Quantité</label>
                            <input type="number" class="form-control" id="quantite" name="quantite" min="1" required>
                        </div>
                    </div>
                    <div class="row mb-3" id="statusInputs" style="display:none;">
                        <label class="form-label">Statut (Articles)</label>
                        <div class="col-md-4">
                            <input type="number" class="form-control" id="bonEtat" name="bonEtat" min="0" placeholder="Bon" value="0" required>
                        </div>
                        <div class="col-md-4">
                            <input type="number" class="form-control" id="mauvaisEtat" name="mauvaisEtat" min="0" placeholder="Mauvais" value="0" required>
                        </div>
                        <div class="col-md-4">
                            <input type="number" class="form-control" id="ferailleEtat" name="ferailleEtat" min="0" placeholder="Ferraille" value="0" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="chantierActuel" class="form-label">Chantier actuel</label>
                            <select class="form-select" id="chantierActuel" name="chantierActuel" disabled>
                                {% if sessionChantier.id %}
                                    <option value="{{ sessionChantier.id }}" selected>{{ sessionChantier.nom }}</option>
                                {% else %}
                                    <option value="">Aucun chantier sélectionné</option>
                                {% endif %}
                            </select>
                        </div>
                        <div class="col-md-6" id="chantierRecInput" style="display:none;">
                            <label for="chantierRec" class="form-label">Chantier destinataire</label>
                            <select class="form-select" id="chantierRec" name="chantierRec" required>
                                <option value="">Sélectionner...</option>
                                {% for chantier in chantiers %}
                                    {% if sessionChantier.id != chantier.id %}
                                        <option value="{{ chantier.id }}">{{ chantier.nom }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3" id="fournisseurInput" style="display:none;">
                        <div class="col-md-6">
                            <label for="fournisseur" class="form-label">Fournisseur</label>
                            <input type="text" class="form-control" id="fournisseur" name="fournisseur" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="observation" class="form-label">Observation</label>
                            <textarea class="form-control" id="observation" name="observation"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-md" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary btn-md" style="background: linear-gradient(90deg, #1e3a8a, #3b82f6); border: none;"><i class="bi bi-save me-1"></i>Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Modifier Mouvement -->
<div class="modal fade" id="editMovementModal" tabindex="-1" aria-labelledby="editMovementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #1e3a8a, #3b82f6); color: white;">
                <h5 class="modal-title" id="editMovementModalLabel"><i class="bi bi-pencil-square me-2"></i>Modifier un mouvement de stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form id="editMovementForm">
                <div class="modal-body">
                    <input type="hidden" id="editMovementId" name="id">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editType" class="form-label">Type de mouvement</label>
                            <select class="form-select" id="editType" name="type" required>
                                <option value="">Sélectionner...</option>
                                <option value="Transfert">Transfert</option>
                                <option value="Augmenter stock">Augmenter stock</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editItemType" class="form-label">Type d'élément</label>
                            <select class="form-select" id="editItemType" name="itemType">
                                <option value="">Sélectionner...</option>
                                <option value="article">Article</option>
                                <option value="machine">Machine</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editItemId" class="form-label">Article/Machine</label>
                            <select class="form-select" id="editItemId" name="itemId" required>
                                <option value="">Sélectionner...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="editQuantite" class="form-label">Quantité</label>
                            <input type="number" class="form-control" id="editQuantite" name="quantite" min="1" required>
                        </div>
                    </div>
                    <div class="row mb-3" id="editStatusInputs" style="display:none;">
                        <label class="form-label">Statut (Articles)</label>
                        <div class="col-md-4">
                            <input type="number" class="form-control" id="editBonEtat" name="bonEtat" min="0" placeholder="Bon" value="0" required>
                        </div>
                        <div class="col-md-4">
                            <input type="number" class="form-control" id="editMauvaisEtat" name="mauvaisEtat" min="0" placeholder="Mauvais" value="0" required>
                        </div>
                        <div class="col-md-4">
                            <input type="number" class="form-control" id="editFerailleEtat" name="ferailleEtat" min="0" placeholder="Ferraille" value="0" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editChantierActuel" class="form-label">Chantier actuel</label>
                            <select class="form-select" id="editChantierActuel" name="chantierActuel" disabled>
                                {% if sessionChantier.id %}
                                    <option value="{{ sessionChantier.id }}" selected>{{ sessionChantier.nom }}</option>
                                {% else %}
                                    <option value="">Aucun chantier sélectionné</option>
                                {% endif %}
                            </select>
                        </div>
                        <div class="col-md-6" id="editChantierRecInput" style="display:none;">
                            <label for="editChantierRec" class="form-label">Chantier destinataire</label>
                            <select class="form-select" id="editChantierRec" name="chantierRec" required>
                                <option value="">Sélectionner...</option>
                                {% for chantier in chantiers %}
                                    {% if sessionChantier.id != chantier.id %}
                                        <option value="{{ chantier.id }}">{{ chantier.nom }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3" id="editFournisseurInput" style="display:none;">
                        <div class="col-md-6">
                            <label for="editFournisseur" class="form-label">Fournisseur</label>
                            <input type="text" class="form-control" id="editFournisseur" name="fournisseur" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="editObservation" class="form-label">Observation</label>
                            <textarea class="form-control" id="editObservation" name="observation"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-md" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary btn-md" style="background: linear-gradient(90deg, #1e3a8a, #3b82f6); border: none;"><i class="bi bi-save me-1"></i>Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var table = $('#stockMovementsTable').DataTable({
        language: { url: 'https://cdn.datatables.net/plug-ins/2.0.7/i18n/fr-FR.json' },
        responsive: true,
        pageLength: 8,
        lengthChange: true,
        info: true,
        searching: true,
        order: [[1, 'desc']],
        dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
             "<'row'<'col-sm-12'tr>>" +
             "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
    });

    let searchBox = $(table.table().container()).find('div.dataTables_filter input');
    searchBox.addClass('form-control ps-5').attr('placeholder', 'Rechercher un mouvement...');
    searchBox.wrap('<div class="position-relative"></div>');
    searchBox.before('<span class="position-absolute top-50 start-0 translate-middle-y ps-3" style="pointer-events:none;"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-search text-secondary" viewBox="0 0 16 16"><path d="M11 6a5 5 0 1 1-10 0 5 5 0 0 1 10 0zm-1.293 6.707a6 6 0 1 0-1.414 1.414l3.85 3.85a1 1 0 0 0 1.415-1.415l-3.85-3.85z"/></svg></span>');
    searchBox.css({ paddingLeft: '2.5rem', marginBottom: '0.5rem', maxWidth: '300px' });

    $('#stockMovementsTable tbody').on('mouseenter', 'tr', function() {
        $(this).addClass('table-hover-effect');
    }).on('mouseleave', 'tr', function() {
        $(this).removeClass('table-hover-effect');
    });

    function manageDynamicFields(formPrefix = '') {
        var typeField = $(`#${formPrefix}type`);
        var itemTypeField = $(`#${formPrefix}itemType`);
        var itemIdField = $(`#${formPrefix}itemId`);
        var quantiteField = $(`#${formPrefix}quantite`);
        var statusInputs = $(`#${formPrefix}statusInputs`);
        var chantierRecInput = $(`#${formPrefix}chantierRecInput`);
        var fournisseurInput = $(`#${formPrefix}fournisseurInput`);
        var chantierRecField = $(`#${formPrefix}chantierRec`);
        var fournisseurField = $(`#${formPrefix}fournisseur`);

        let selectedItemId = null;

        typeField.on('change', function() {
            var type = $(this).val();
            selectedItemId = itemIdField.val();
            fournisseurInput.hide();
            chantierRecInput.hide();
            statusInputs.hide();
            chantierRecField.prop('required', false);
            fournisseurField.prop('required', false);
            itemIdField.empty().append('<option value="">Sélectionner...</option>');
            itemTypeField.val('').trigger('change');
            if (type) {
                $.ajax({
                    url: '/stock_movement/fetch_items',
                    method: 'POST',
                    data: { type: type },
                    success: function(response) {
                        if (response.success && response.items.length > 0) {
                            var options = '<option value="">Sélectionner...</option>';
                            response.items.forEach(function(item) {
                                options += `<option value="${item.id}" data-type="${item.type}">${item.name}</option>`;
                            });
                            itemIdField.html(options);
                            if (selectedItemId) {
                                itemIdField.val(selectedItemId).trigger('change');
                            }
                        } else {
                            itemIdField.html('<option value="">Aucun élément disponible</option>');
                        }
                    },
                    error: function() {
                        itemIdField.html('<option value="">Erreur de chargement</option>');
                    }
                });
            }
            if (type === 'Transfert') {
                chantierRecInput.show();
                chantierRecField.prop('required', true);
            } else if (type === 'Augmenter stock') {
                fournisseurInput.show();
                fournisseurField.prop('required', true);
            }
        });

        itemTypeField.on('change', function() {
            var itemType = $(this).val();
            selectedItemId = itemIdField.val();
            statusInputs.hide();
            itemIdField.empty().append('<option value="">Sélectionner...</option>');
            if (itemType) {
                $.ajax({
                    url: '/stock_movement/fetch_items',
                    method: 'POST',
                    data: { type: typeField.val(), itemType: itemType },
                    success: function(response) {
                        if (response.success && response.items.length > 0) {
                            var options = '<option value="">Sélectionner...</option>';
                            response.items.forEach(function(item) {
                                options += `<option value="${item.id}" data-type="${item.type}">${item.name}</option>`;
                            });
                            itemIdField.html(options);
                            if (selectedItemId) {
                                itemIdField.val(selectedItemId).trigger('change');
                            }
                        } else {
                            itemIdField.html(`<option value="">Aucun ${itemType} disponible</option>`);
                        }
                    },
                    error: function() {
                        itemIdField.html('<option value="">Erreur de chargement</option>');
                    }
                });
            }
            if (itemType === 'article') {
                statusInputs.show();
            }
        });

        itemIdField.on('change', function() {
            var selectedOption = $(this).find('option:selected');
            var type = selectedOption.data('type');
            selectedItemId = $(this).val();
            if (type && itemTypeField.val() !== type) {
                itemTypeField.val(type).trigger('change');
            }
            if (typeField.val() === 'Transfert' && $(this).val() !== '') {
                var itemId = $(this).val();
                var chantierId = $(`#${formPrefix}chantierActuel`).val();
                $.ajax({
                    url: '/stock_movement/check_quantity',
                    method: 'POST',
                    data: { itemId: itemId, chantierId: chantierId },
                    success: function(response) {
                        if (response.success) {
                            quantiteField.attr('max', response.available);
                            quantiteField.attr('placeholder', 'Max: ' + response.available);
                        } else {
                            quantiteField.attr('max', 0);
                            quantiteField.attr('placeholder', 'Aucun stock disponible');
                        }
                    }
                });
            } else {
                quantiteField.removeAttr('max');
                quantiteField.attr('placeholder', '');
            }
        });
    }

    manageDynamicFields();
    manageDynamicFields('edit');

    function fillEditForm(data) {
        $('#editMovementId').val(data.id);
        $('#editType').val(data.type);

        // Wait for type change to finish loading item types
        $('#editType').off('change._edit').on('change._edit', function() {
            $('#editItemType').val(data.itemType);

            // Wait for itemType change to finish loading items
            $('#editItemType').off('change._edit').on('change._edit', function() {
                // Populate itemId dropdown and select the existing item
                $.ajax({
                    url: '/stock_movement/fetch_items',
                    method: 'POST',
                    data: { type: data.type, itemType: data.itemType },
                    success: function(response) {
                        if (response.success && response.items.length > 0) {
                            var options = '<option value="">Sélectionner...</option>';
                            response.items.forEach(function(item) {
                                var selected = (item.id == data.itemId) ? ' selected' : '';
                                options += `<option value="${item.id}" data-type="${item.type}"${selected}>${item.name}</option>`;
                            });
                            $('#editItemId').html(options);
                        } else {
                            $('#editItemId').html('<option value="">Aucun élément disponible</option>');
                        }
                    },
                    error: function() {
                        $('#editItemId').html('<option value="">Erreur de chargement</option>');
                    }
                });
            }).trigger('change');
        }).trigger('change');

        $('#editQuantite').val(data.quantite);
        $('#editBonEtat').val(data.bonEtat || 0);
        $('#editMauvaisEtat').val(data.mauvaisEtat || 0);
        $('#editFerailleEtat').val(data.ferailleEtat || 0);
        $('#editChantierRec').val(data.chantierRec || '');
        $('#editFournisseur').val(data.fournisseur || '');
        $('#editObservation').val(data.observation || '');

        // Show/hide fields based on type and itemType
        if (data.type === 'Transfert') {
            $('#editChantierRecInput').show();
            $('#editChantierRec').prop('required', true);
            $('#editFournisseurInput').hide();
            $('#editFournisseur').prop('required', false);
        } else if (data.type === 'Augmenter stock') {
            $('#editFournisseurInput').show();
            $('#editFournisseur').prop('required', true);
            $('#editChantierRecInput').hide();
            $('#editChantierRec').prop('required', false);
        }
        if (data.itemType === 'article') {
            $('#editStatusInputs').show();
        } else {
            $('#editStatusInputs').hide();
        }
    }

    // --- SweetAlert2: Use timer, hide confirm, show progress bar for all success/error ---
    // Add/modify movement
    $('#addMovementForm').on('submit', function(e) {
        e.preventDefault();
        var quantite = parseInt($('#quantite').val(), 10);
        var bonEtat = parseInt($('#bonEtat').val() || 0);
        var mauvaisEtat = parseInt($('#mauvaisEtat').val() || 0);
        var ferailleEtat = parseInt($('#ferailleEtat').val() || 0);
        var total = bonEtat + mauvaisEtat + ferailleEtat;

        if ($('#itemType').val() === 'article' && total !== quantite) {
            Swal.fire({
                icon: 'error',
                title: 'Erreur',
                text: 'La somme des états (Bon, Mauvais, Ferraille) doit être égale à la quantité.',
                timer: 3500,
                showConfirmButton: false,
                timerProgressBar: true
            });
            return;
        }

        var formData = $(this).serialize();
        $.ajax({
            url: '/stock_movement/new',
            method: 'POST',
            data: formData,
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Succès',
                        text: response.message || 'Mouvement ajouté avec succès!',
                        timer: 2500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });
                        $('#addMovementModal').modal('hide');
                        $('#addMovementForm')[0].reset();
                        $('#itemId').empty().append('<option value="">Sélectionner...</option>');
                        $('#itemType').val('');
                        $('#type').val('');
                        $('#statusInputs').hide();
                        $('#chantierRecInput').hide();
                        $('#fournisseurInput').hide();
                    // Dynamically add the new row to DataTable
                    if (response.movement) {
                        var m = response.movement;
                        var articleOrMachine = m.article ? m.article.nom : (m.machine ? m.machine.nom : '-');
                        var chantierRec = m.chantierRec ? m.chantierRec.nom : '-';
                        var statusHtml = m.status === 'valid' ? '<i class="bi bi-check-circle text-success"></i> Validé' : (m.status === 'rejected' ? '<i class="bi bi-x-circle text-danger"></i> Rejeté' : '<i class="bi bi-hourglass-split text-warning"></i> En attente');
                        var actions = '';
                        if (m.canEdit) {
                            if (m.status === 'waiting') {
                                actions += `<button class="btn btn-sm btn-outline-success" onclick="changeStatus(${m.id}, 'valid')"><i class="bi bi-check-circle"></i></button> `;
                                actions += `<button class="btn btn-sm btn-outline-danger" onclick="changeStatus(${m.id}, 'rejected')"><i class="bi bi-x-circle"></i></button> `;
                            }
                            actions += `<button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMovementModal" data-id="${m.id}" data-item-id="${m.article ? m.article.id : (m.machine ? m.machine.id : '')}" data-item-name="${articleOrMachine}" data-item-type="${m.article ? 'article' : (m.machine ? 'machine' : '')}"><i class="bi bi-pencil"></i></button> `;
                            actions += `<button class="btn btn-sm btn-outline-danger" onclick="showDeleteAlert('Êtes-vous sûr de vouloir supprimer ce mouvement ?', ${m.id})"><i class="bi bi-trash"></i></button>`;
                        } else {
                            actions = '<span class="text-muted">En attente (hors chantier)</span>';
                        }
                        var newRow = table.row.add([
                            m.displayType,
                            m.date ? m.date : '',
                            articleOrMachine,
                            m.quantite,
                            chantierRec,
                            statusHtml,
                            actions
                        ]).draw(false).node();
                        $(newRow).addClass('table-success');
                        setTimeout(function() { $(newRow).removeClass('table-success'); }, 3000);
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                        text: response.message || 'Erreur lors de l\'ajout du mouvement.',
                        timer: 3500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });
                }
            },
            error: function(xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: 'Une erreur s\'est produite. Veuillez réessayer.',
                    timer: 3500,
                    showConfirmButton: false,
                    timerProgressBar: true
                });
            }
        });
    });

    // --- Loading feedback for edit ---
    $('#editMovementModal').on('show.bs.modal', function(e) {
        var button = $(e.relatedTarget);
        var id = button.data('id');
        var itemId = button.data('item-id');
        var itemName = button.data('item-name');
        var itemType = button.data('item-type');
        Swal.fire({
            title: 'Chargement...',
            html: 'Récupération des données du mouvement',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        $.ajax({
            url: '/stock_movement/' + id + '/edit',
            method: 'GET',
            success: function(response) {
                Swal.close();
                setTimeout(function() {
                if (response.success === false) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                            text: response.message || 'Erreur lors du chargement des données.',
                            timer: 3500,
                            showConfirmButton: false,
                            timerProgressBar: true
                    });
                    return;
                }
                response.data.itemId = itemId;
                response.data.itemType = itemType;
                response.data.itemName = itemName;
                fillEditForm(response.data);
                }, 80);
            },
            error: function() {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: 'Erreur lors du chargement des données.',
                    timer: 3500,
                    showConfirmButton: false,
                    timerProgressBar: true
                });
            }
        });
    });

    // --- Edit movement form ---
    $('#editMovementForm').on('submit', function(e) {
        e.preventDefault();
        var quantite = parseInt($('#editQuantite').val(), 10);
        var bonEtat = parseInt($('#editBonEtat').val() || 0);
        var mauvaisEtat = parseInt($('#editMauvaisEtat').val() || 0);
        var ferailleEtat = parseInt($('#editFerailleEtat').val() || 0);
        var total = bonEtat + mauvaisEtat + ferailleEtat;

        if ($('#editItemType').val() === 'article' && total !== quantite) {
            Swal.fire({
                icon: 'error',
                title: 'Erreur',
                text: 'La somme des états (Bon, Mauvais, Ferraille) doit être égale à la quantité.',
                timer: 3500,
                showConfirmButton: false,
                timerProgressBar: true
            });
            return;
        }

        var formData = $(this).serialize();
        $.ajax({
            url: '/stock_movement/edit',
            method: 'POST',
            data: formData,
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Succès',
                        text: response.message || 'Mouvement modifié avec succès!',
                        timer: 2500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });
                    $('#editMovementModal').modal('hide');
                    // Dynamically update the row in DataTable
                    if (response.movement) {
                        var m = response.movement;
                        // Find the row by movement ID
                        var row = null;
                        table.rows().every(function() {
                            var data = this.data();
                            // The ID is not in the table, so we need to match by unique fields (date, type, article/machine, quantite, etc.)
                            // For best results, add a data attribute to the row when adding, but for now, try to match by type/date/quantite
                            if (
                                data[0] === m.displayType &&
                                data[1] === (m.date ? m.date : '') &&
                                data[2] === (m.article ? m.article.nom : (m.machine ? m.machine.nom : '-')) &&
                                data[3] == m.quantite
                            ) {
                                row = this;
                            }
                        });
                        var articleOrMachine = m.article ? m.article.nom : (m.machine ? m.machine.nom : '-');
                        var chantierRec = m.chantierRec ? m.chantierRec.nom : '-';
                        var statusHtml = m.status === 'valid' ? '<i class="bi bi-check-circle text-success"></i> Validé' : (m.status === 'rejected' ? '<i class="bi bi-x-circle text-danger"></i> Rejeté' : '<i class="bi bi-hourglass-split text-warning"></i> En attente');
                        var actions = '';
                        if (m.canEdit) {
                            if (m.status === 'waiting') {
                                actions += `<button class="btn btn-sm btn-outline-success" onclick="changeStatus(${m.id}, 'valid')"><i class="bi bi-check-circle"></i></button> `;
                                actions += `<button class="btn btn-sm btn-outline-danger" onclick="changeStatus(${m.id}, 'rejected')"><i class="bi bi-x-circle"></i></button> `;
                            }
                            actions += `<button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMovementModal" data-id="${m.id}" data-item-id="${m.article ? m.article.id : (m.machine ? m.machine.id : '')}" data-item-name="${articleOrMachine}" data-item-type="${m.article ? 'article' : (m.machine ? 'machine' : '')}"><i class="bi bi-pencil"></i></button> `;
                            actions += `<button class="btn btn-sm btn-outline-danger" onclick="showDeleteAlert('Êtes-vous sûr de vouloir supprimer ce mouvement ?', ${m.id})"><i class="bi bi-trash"></i></button>`;
                        } else {
                            actions = '<span class="text-muted">En attente (hors chantier)</span>';
                        }
                        if (row) {
                            row.data([
                                m.displayType,
                                m.date ? m.date : '',
                                articleOrMachine,
                                m.quantite,
                                chantierRec,
                                statusHtml,
                                actions
                            ]).draw(false);
                        } else {
                            // If not found, add as new row
                            var newRow = table.row.add([
                                m.displayType,
                                m.date ? m.date : '',
                                articleOrMachine,
                                m.quantite,
                                chantierRec,
                                statusHtml,
                                actions
                            ]).draw(false).node();
                            $(newRow).addClass('table-success');
                            setTimeout(function() { $(newRow).removeClass('table-success'); }, 3000);
                        }
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                        text: response.message || 'Erreur lors de la modification du mouvement.',
                        timer: 3500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });
                }
            },
            error: function(xhr, status, error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: 'Une erreur s\'est produite. Veuillez réessayer.',
                    timer: 3500,
                    showConfirmButton: false,
                    timerProgressBar: true
                });
            }
        });
    });
});

function changeStatus(id, status) {
    Swal.fire({
        title: `Êtes-vous sûr de vouloir ${status === 'valid' ? 'valider' : 'rejeter'} ce mouvement ?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Oui',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: '/stock_movement/change_status/' + id + '/' + status,
                method: 'POST',
                success: function(response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Succès',
                        text: response.message || 'Statut modifié avec succès!',
                        timer: 2500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });
                    // No reload needed, the row will be updated by the edit form
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                        text: 'Erreur lors de la modification du statut.',
                        timer: 3500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });
                }
            });
        }
    });
}

function showDeleteAlert(message, id) {
    Swal.fire({
        title: message,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Oui, supprimer',
        cancelButtonText: 'Annuler'
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: '/stock_movement/delete/' + id,
                method: 'POST',
                success: function(response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Succès',
                        text: response.message || 'Mouvement supprimé avec succès!',
                        timer: 2500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    }).then(() => {
                        // No reload needed, the row will be removed by the DataTable
                    });
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                        text: 'Erreur lors de la suppression du mouvement.',
                        timer: 3500,
                        showConfirmButton: false,
                        timerProgressBar: true
                    });
                }
            });
        }
    });
}
</script>

